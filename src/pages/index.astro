  // ─── Render Functions ───
  function renderTechStack(filter) {
    const grid = document.getElementById('previewGrid');
    grid.innerHTML = PREVIEW_ITEMS
      .filter(item => filter === 'all' || item.cat === filter)
      .map(item => `
        <div class="preview-item">
          <div class="preview-item-icon preview-item-icon--${item.color}">${item.icon}</div>
          <div>
            <div class="preview-item-label">${item.label}</div>
            <div class="preview-item-meta">${item.meta}</div>
          </div>
        </div>
      `).join('');
  }

  let currentPhase = 0;

  function renderPhaseTabs() {
    return SYLLABUS.map((p, i) => `
      <button class="ps-phase-tab ${i === currentPhase ? 'active' : ''}" data-pidx="${i}">
        <span>${p.tag}</span>
        <span style="color:var(--text-muted);font-weight:400;font-size:10px;">${p.title}</span>
      </button>
    `).join('');
  }

  function renderPhaseContent(index) {
    const p = SYLLABUS[index];
    if (!p) return '';
    return `
      <div class="ps-header">
        <span class="ps-tag ${p.tagCls}">${p.tag}</span>
        <span class="ps-title">${p.title}</span>
        <span class="ps-dur">${p.dur}</span>
      </div>
      <div class="ps-topics">
        ${p.topics.map(t => `
          <div class="ps-topic">
            <span class="ps-idx">${t.idx}</span>
            <div>
              <div class="ps-topic-name">${t.name}</div>
              <div class="ps-resources">
                ${t.resources.map(r => `<span class="ps-res">${r}</span>`).join('')}
              </div>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  }

  function selectPhase(index) {
    currentPhase = index;
    const content = document.getElementById('psContent');
    content.innerHTML = renderPhaseContent(index);
    // Re-render tabs to update active state
    const tabBar = document.getElementById('psTabBar');
    tabBar.innerHTML = renderPhaseTabs();
    // Re-attach click handlers
    tabBar.querySelectorAll('.ps-phase-tab').forEach(btn => {
      btn.addEventListener('click', () => selectPhase(Number(btn.dataset.pidx)));
    });
  }

  function renderSyllabus() {
    const container = document.getElementById('previewSyllabus');
    container.innerHTML = `
      <div class="ps-phase-tabs" id="psTabBar">${renderPhaseTabs()}</div>
      <div class="ps-active-phase" id="psContent">${renderPhaseContent(currentPhase)}</div>
    `;
    container.querySelectorAll('.ps-phase-tab').forEach(btn => {
      btn.addEventListener('click', () => selectPhase(Number(btn.dataset.pidx)));
    });
  }

  // ─── View Switching ───
  function showView(view) {
    document.getElementById('previewStack').style.display = view === 'stack' ? '' : 'none';
    document.getElementById('previewSyllabus').style.display = view === 'syllabus' ? '' : 'none';
  }

  document.querySelectorAll('.pv-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.pv-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      showView(tab.dataset.view);
    });
  });

  document.querySelectorAll('.pf-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.pf-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderTechStack(btn.dataset.pf);
    });
  });

  renderTechStack('all');
  renderSyllabus();

