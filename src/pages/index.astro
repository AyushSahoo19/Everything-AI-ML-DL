---
import '../styles/home.css';
import Analytics from '@vercel/analytics/astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI/ML/DL Roadmap — From Zero to Machine Intelligence</title>
  <meta name="description" content="A curated, structured 12–18 month AI/ML/DL learning roadmap. 8 phases from Python to LLMs, 30+ topics, 100+ hand-picked resources with a step-by-step guidance system.">
  <meta name="theme-color" content="#181818">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="AI ML DL">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/icon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    }
  </script>
</head>
<body>

<!-- ═══════════════════════════════════════════
     NAVBAR
═══════════════════════════════════════════ -->
<nav class="navbar" id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-brand">
      <div class="nav-brand-icon">@</div>
      AI · ML · DL
    </a>

    <div class="nav-divider"></div>

    <div class="nav-links">
      <a href="#roadmap"   class="nav-link">Roadmap</a>
      <a href="#syllabus"  class="nav-link">Syllabus</a>
      <a href="#guidance"  class="nav-link">Guidance</a>
      <a href="#resources" class="nav-link">Resources</a>
    </div>

    <a href="/dashboard" class="nav-cta">
      Open Dashboard
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</nav>


<!-- ═══════════════════════════════════════════
     HERO
═══════════════════════════════════════════ -->
<header>
  <div class="hero">
    <div class="hero-left">
      <div class="hero-eyebrow">
        <div class="hero-eyebrow-line"></div>
        <span class="hero-eyebrow-text">12–18 Month Complete Journey</span>
      </div>

      <h1 class="hero-title">
        From Zero to<br>
        <span class="hero-title-accent">Machine Intelligence</span>
      </h1>

      <p class="hero-subtitle">
        A curated, opinionated roadmap through Python, Math, Classical ML, Deep Learning,
        First Principles, Specialisation, LLMs, and MLOps — every resource hand-picked,
        every phase guided step-by-step.
      </p>

      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-num">8</div>
          <div class="stat-label">Phases</div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <div class="stat-num">30+</div>
          <div class="stat-label">Topics</div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <div class="stat-num">100+</div>
          <div class="stat-label">Resources</div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <div class="stat-num">Free</div>
          <div class="stat-label">Always</div>
        </div>
      </div>

      <div class="hero-actions">
        <a href="/dashboard" class="btn-primary-home">
          Start Learning
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#roadmap" class="btn-secondary-home">
          View Roadmap
        </a>
      </div>

      <div class="hero-tags">
        <span class="hero-tag">Python</span>
        <span class="hero-tag">NumPy · Pandas</span>
        <span class="hero-tag">Linear Algebra</span>
        <span class="hero-tag">PyTorch</span>
        <span class="hero-tag">Transformers</span>
        <span class="hero-tag">LLMs</span>
        <span class="hero-tag">LoRA · RLHF</span>
        <span class="hero-tag">MLOps</span>
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-right-header">
        <div class="hero-right-label">What You'll Cover</div>
        <div class="hero-right-desc">A structured path across 8 phases — from Python foundations to production ML systems</div>
      </div>
      <div class="hero-phase-grid">
        <a href="/dashboard" class="hpc">
          <span class="hpc-num">0</span>
          <div class="hpc-body">
            <span class="hpc-stage">Phase 0</span>
            <span class="hpc-name">Python Foundation</span>
          </div>
        </a>
        <a href="/dashboard" class="hpc">
          <span class="hpc-num">1</span>
          <div class="hpc-body">
            <span class="hpc-stage">Phase 1</span>
            <span class="hpc-name">Math for ML</span>
          </div>
        </a>
        <a href="/dashboard" class="hpc">
          <span class="hpc-num">2</span>
          <div class="hpc-body">
            <span class="hpc-stage">Stages 1–2</span>
            <span class="hpc-name">Classical ML</span>
          </div>
        </a>
        <a href="/dashboard" class="hpc">
          <span class="hpc-num">3</span>
          <div class="hpc-body">
            <span class="hpc-stage">Stage 3</span>
            <span class="hpc-name">Deep Learning</span>
          </div>
        </a>
        <a href="/dashboard" class="hpc">
          <span class="hpc-num">4</span>
          <div class="hpc-body">
            <span class="hpc-stage">Stage 4</span>
            <span class="hpc-name">First Principles</span>
          </div>
        </a>
        <a href="/dashboard" class="hpc">
          <span class="hpc-num">5</span>
          <div class="hpc-body">
            <span class="hpc-stage">Stage 5</span>
            <span class="hpc-name">Specialisation</span>
          </div>
        </a>
        <a href="/dashboard" class="hpc">
          <span class="hpc-num">6</span>
          <div class="hpc-body">
            <span class="hpc-stage">Stage 6</span>
            <span class="hpc-name">Large Language Models</span>
          </div>
        </a>
        <a href="/dashboard" class="hpc">
          <span class="hpc-num">7</span>
          <div class="hpc-body">
            <span class="hpc-stage">Stage 7</span>
            <span class="hpc-name">MLOps</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</header>


<!-- ═══════════════════════════════════════════
     CURRICULUM DASHBOARD PREVIEW
═══════════════════════════════════════════ -->
<section class="section" id="preview">
  <div class="container">
    <div class="section-header">
      <div class="section-eyebrow">Dashboard Preview</div>
      <h2 class="section-title">What You'll Learn</h2>
      <p class="section-subtitle">Every tool, framework, concept, and resource across all 8 phases — browse by tech stack or by syllabus.</p>
    </div>

    <div class="preview-panel">
      <div class="preview-tabs">
        <button class="pv-tab active" data-view="stack">Tech Stack</button>
        <button class="pv-tab" data-view="syllabus">Full Syllabus</button>
      </div>

      <div id="previewStack">
        <div class="preview-filter-bar">
          <button class="pf-btn active" data-pf="all">All Topics</button>
          <button class="pf-btn" data-pf="lang">Languages</button>
          <button class="pf-btn" data-pf="math">Mathematics</button>
          <button class="pf-btn" data-pf="ml">Classical ML</button>
          <button class="pf-btn" data-pf="dl">Deep Learning</button>
          <button class="pf-btn" data-pf="llm">LLMs</button>
          <button class="pf-btn" data-pf="mlops">MLOps</button>
        </div>
        <div class="preview-grid" id="previewGrid">
          <!-- Populated by JS -->
        </div>
      </div>

      <div id="previewSyllabus" style="display:none;">
        <!-- Populated by JS -->
      </div>
    </div>

    <a href="/dashboard" class="preview-cta">
      Open Full Dashboard
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     RESOURCES PHASE-WISE
═══════════════════════════════════════════ -->
<section class="section" id="resources">
  <div class="container">
    <div class="section-header">
      <div class="section-eyebrow">Resources</div>
      <h2 class="section-title">Everything You Need, Phase by Phase</h2>
      <p class="section-subtitle">Curated courses, papers, books, repos, and tutorials — hand-picked for each stage of the journey.</p>
    </div>

    <div class="res-panel">
      <div class="res-sidebar" id="resSidebar">
        <!-- Populated by JS -->
      </div>
      <div class="res-content" id="resContent">
        <!-- Populated by JS -->
      </div>
    </div>

    <div style="text-align:center;margin-top:36px;">
      <a href="/dashboard" class="res-cta">Browse All Resources →</a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     ROADMAP TIMELINE
═══════════════════════════════════════════ -->
<section class="section" id="roadmap">
  <div class="container">
    <div class="section-header">
      <div class="section-eyebrow">The Journey</div>
      <h2 class="section-title">8 Phases, 12–18 Months</h2>
      <p class="section-subtitle">Each phase directly unlocks the next. Linear, deliberate, no skipping.</p>
    </div>

    <div class="roadmap-list">

      <div class="phase-row">
        <div class="phase-spine">
          <div class="spine-dot"></div>
          <div class="spine-line"></div>
        </div>
        <div class="phase-card">
          <div class="phase-card-top">
            <div class="phase-tag-row">
              <span class="phase-stage-label">Phase 0</span>
              <span class="phase-dur-label">4–6 weeks</span>
            </div>
            <a href="/dashboard" class="phase-open-link">Open →</a>
          </div>
          <div class="phase-card-title">Python Foundation</div>
          <p class="phase-card-desc">Python is the universal language of ML. Master it before everything else. OOP, NumPy, Pandas, and Matplotlib are the toolkit you'll use daily for the next decade.</p>
          <div class="phase-pills">
            <span class="phase-pill">CS50P</span>
            <span class="phase-pill">NumPy Crash Course</span>
            <span class="phase-pill">Kaggle Pandas</span>
            <span class="phase-pill">Matplotlib</span>
            <span class="phase-pill">PDSH (VanderPlas)</span>
          </div>
        </div>
      </div>

      <div class="phase-row">
        <div class="phase-spine">
          <div class="spine-dot"></div>
          <div class="spine-line"></div>
        </div>
        <div class="phase-card">
          <div class="phase-card-top">
            <div class="phase-tag-row">
              <span class="phase-stage-label">Phase 1</span>
              <span class="phase-dur-label">6–8 weeks</span>
            </div>
            <a href="/dashboard" class="phase-open-link">Open →</a>
          </div>
          <div class="phase-card-title">Math for ML</div>
          <p class="phase-card-desc">ML is applied mathematics. Linear algebra defines data representation. Calculus explains how learning happens. Probability models uncertainty.</p>
          <div class="phase-pills">
            <span class="phase-pill">3Blue1Brown</span>
            <span class="phase-pill">Imperial College Coursera</span>
            <span class="phase-pill">StatQuest</span>
            <span class="phase-pill">Seeing Theory</span>
          </div>
        </div>
      </div>

      <div class="phase-row">
        <div class="phase-spine">
          <div class="spine-dot"></div>
          <div class="spine-line"></div>
        </div>
        <div class="phase-card">
          <div class="phase-card-top">
            <div class="phase-tag-row">
              <span class="phase-stage-label">Stages 1–2</span>
              <span class="phase-dur-label">10–12 weeks</span>
            </div>
            <a href="/dashboard" class="phase-open-link">Open →</a>
          </div>
          <div class="phase-card-title">Classical ML</div>
          <p class="phase-card-desc">Classical ML teaches what deep learning hides — bias-variance tradeoff, regularisation, cross-validation, feature engineering. Non-negotiable fundamentals.</p>
          <div class="phase-pills">
            <span class="phase-pill">Andrew Ng Specialization</span>
            <span class="phase-pill">ISLP Textbook</span>
            <span class="phase-pill">XGBoost Paper</span>
            <span class="phase-pill">Hands-On ML</span>
          </div>
        </div>
      </div>

      <div class="phase-row">
        <div class="phase-spine">
          <div class="spine-dot"></div>
          <div class="spine-line"></div>
        </div>
        <div class="phase-card">
          <div class="phase-card-top">
            <div class="phase-tag-row">
              <span class="phase-stage-label">Stage 3</span>
              <span class="phase-dur-label">12–16 weeks</span>
            </div>
            <a href="/dashboard" class="phase-open-link">Open →</a>
          </div>
          <div class="phase-card-title">Deep Learning</div>
          <p class="phase-card-desc">Systematic mastery of neural networks — forward and backward passes, CNNs, RNNs, LSTMs, regularisation tricks, and real PyTorch engineering.</p>
          <div class="phase-pills">
            <span class="phase-pill">DL Specialization (Ng)</span>
            <span class="phase-pill">ResNet Paper</span>
            <span class="phase-pill">Adam · Dropout</span>
            <span class="phase-pill">Stanford CS224n</span>
          </div>
        </div>
      </div>

      <div class="phase-row">
        <div class="phase-spine">
          <div class="spine-dot"></div>
          <div class="spine-line"></div>
        </div>
        <div class="phase-card">
          <div class="phase-card-top">
            <div class="phase-tag-row">
              <span class="phase-stage-label">Stage 4</span>
              <span class="phase-dur-label">6–8 weeks</span>
            </div>
            <a href="/dashboard" class="phase-open-link">Open →</a>
          </div>
          <div class="phase-card-title">First Principles</div>
          <p class="phase-card-desc">Build every component of a neural network from scratch. After this stage no black box remains. Karpathy's Zero-to-Hero series is the core curriculum.</p>
          <div class="phase-pills">
            <span class="phase-pill">micrograd</span>
            <span class="phase-pill">makemore</span>
            <span class="phase-pill">Let's build GPT</span>
            <span class="phase-pill">Attention Is All You Need</span>
          </div>
        </div>
      </div>

      <div class="phase-row">
        <div class="phase-spine">
          <div class="spine-dot"></div>
          <div class="spine-line"></div>
        </div>
        <div class="phase-card">
          <div class="phase-card-top">
            <div class="phase-tag-row">
              <span class="phase-stage-label">Stage 5</span>
              <span class="phase-dur-label">12–16 weeks</span>
            </div>
            <a href="/dashboard" class="phase-open-link">Open →</a>
          </div>
          <div class="phase-card-title">Specialisation</div>
          <p class="phase-card-desc">Go deep in one domain. Choose ONE track: Computer Vision (CS231n), NLP (CS224n + HuggingFace), or Reinforcement Learning (David Silver). Depth is what makes you employable.</p>
          <div class="phase-pills">
            <span class="phase-pill">Stanford CS231n</span>
            <span class="phase-pill">Stanford CS224n</span>
            <span class="phase-pill">David Silver RL</span>
            <span class="phase-pill">HuggingFace</span>
          </div>
        </div>
      </div>

      <div class="phase-row">
        <div class="phase-spine">
          <div class="spine-dot"></div>
          <div class="spine-line"></div>
        </div>
        <div class="phase-card">
          <div class="phase-card-top">
            <div class="phase-tag-row">
              <span class="phase-stage-label">Stage 6</span>
              <span class="phase-dur-label">10–14 weeks</span>
            </div>
            <a href="/dashboard" class="phase-open-link">Open →</a>
          </div>
          <div class="phase-card-title">Large Language Models</div>
          <p class="phase-card-desc">Turn from a user of LLMs into someone who builds, fine-tunes, and deploys them. Pre-training, LoRA, RLHF, alignment — and reading production model source code.</p>
          <div class="phase-pills">
            <span class="phase-pill">Stanford CS336</span>
            <span class="phase-pill">GPT-3 Paper</span>
            <span class="phase-pill">LoRA · InstructGPT</span>
            <span class="phase-pill">LLaMA 3</span>
          </div>
        </div>
      </div>

      <div class="phase-row phase-row--last">
        <div class="phase-spine">
          <div class="spine-dot"></div>
          <div class="spine-line"></div>
        </div>
        <div class="phase-card">
          <div class="phase-card-top">
            <div class="phase-tag-row">
              <span class="phase-stage-label">Stage 7</span>
              <span class="phase-dur-label">8–10 weeks</span>
            </div>
            <a href="/dashboard" class="phase-open-link">Open →</a>
          </div>
          <div class="phase-card-title">MLOps</div>
          <p class="phase-card-desc">Reliable, scalable ML systems — data pipelines, deployment, monitoring, versioning. Turn your models into real, production-grade systems that stay alive in the real world.</p>
          <div class="phase-pills">
            <span class="phase-pill">Made With ML</span>
            <span class="phase-pill">FastAPI · Docker</span>
            <span class="phase-pill">MLflow</span>
            <span class="phase-pill">Chip Huyen</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     FULL SYLLABUS INDEX
═══════════════════════════════════════════ -->
<section class="section" id="syllabus">
  <div class="container">
    <div class="section-header">
      <div class="section-eyebrow">Full Syllabus</div>
      <h2 class="section-title">Complete Content Index</h2>
      <p class="section-subtitle">Every topic, subtopic, and resource — indexed with phase numbers and resource types.</p>
    </div>

    <div class="syllabus-list">

      <!-- Phase 0 -->
      <div class="syllabus-phase-block">
        <div class="syllabus-phase-header">
          <span class="syl-tag syl-tag-0">Phase 0</span>
          <span class="syllabus-phase-title">Python Foundation</span>
          <span class="syllabus-phase-dur">4–6 weeks</span>
          <a href="/dashboard" class="syllabus-phase-link">Open →</a>
        </div>
        <div class="syllabus-topics">
          <div class="syl-topic-row">
            <span class="syl-index">0.1</span>
            <div class="syl-topic-body">
              <div class="syl-topic-name">Python Basics & OOP</div>
              <div class="syl-resources">
                <span class="res res-course">CS50P (Harvard)</span>
                <span class="res res-yt">Corey Schafer OOP</span>
                <span class="res res-book">Automate the Boring Stuff</span>
                <span class="res res-web">W3Schools Python</span>
              </div>
            </div>
          </div>
          <div class="syl-topic-row">
            <span class="syl-index">0.2</span>
            <div class="syl-topic-body">
              <div class="syl-topic-name">Numerical Data with NumPy</div>
              <div class="syl-resources">
                <span class="res res-yt">NumPy Crash Course (FCC)</span>
                <span class="res res-book">PDSH Ch.2 — VanderPlas</span>
              </div>
            </div>
          </div>
          <div class="syl-topic-row">
            <span class="syl-index">0.3</span>
            <div class="syl-topic-body">
              <div class="syl-topic-name">Data Wrangling with Pandas</div>
              <div class="syl-resources">
                <span class="res res-course">Kaggle Pandas Course</span>
                <span class="res res-yt">Keith Galli Tutorial</span>
                <span class="res res-book">PDSH Ch.3</span>
              </div>
            </div>
          </div>
          <div class="syl-topic-row">
            <span class="syl-index">0.4</span>
            <div class="syl-topic-body">
              <div class="syl-topic-name">Data Visualization</div>
              <div class="syl-resources">
                <span class="res res-yt">Corey Schafer Matplotlib</span>
                <span class="res res-web">Seaborn Gallery</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Phase 1 -->
      <div class="syllabus-phase-block">
        <div class="syllabus-phase-header">
          <span class="syl-tag syl-tag-1">Phase 1</span>
          <span class="syllabus-phase-title">Math for ML</span>
          <span class="syllabus-phase-dur">6–8 weeks</span>
          <a href="/dashboard" class="syllabus-phase-link">Open →</a>
        </div>
        <div class="syllabus-topics">
          <div class="syl-topic-row">
            <span class="syl-index">1.1</span>
            <div class="syl-topic-body">
              <div class="syl-topic-name">Linear Algebra</div>
              <div class="syl-resources">
                <span class="res res-course">Imperial College / Coursera</span>
                <span class="res res-yt">Essence of Linear Algebra (3B1B)</span>
                <span class="res res-book">Linear Algebra Done Right</span>
              </div>
            </div>
          </div>
          <div class="syl-topic-row">
            <span class="syl-index">1.2</span>
            <div class="syl-topic-body">
              <div class="syl-topic-name">Multivariate Calculus</div>
              <div class="syl-resources">
                <span class="res res-course">Imperial College Calculus</span>
                <span class="res res-yt">Essence of Calculus (3B1B)</span>
                <span class="res res-paper">Matrix Calculus for DL (Parr & Howard)</span>
              </div>
            </div>
          </div>
          <div class="syl-topic-row">
            <span class="syl-index">1.3</span>
            <div class="syl-topic-body">
              <div class="syl-topic-name">Probability & Statistics</div>
              <div class="syl-resources">
                <span class="res res-yt">StatQuest (Josh Starmer)</span>
                <span class="res res-book">Probabilistic ML Vol.1 (Murphy)</span>
                <span class="res res-web">Seeing Theory (Brown Univ.)</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stages 1–2 -->
      <div class="syllabus-phase-block">
        <div class="syllabus-phase-header">
          <span class="syl-tag syl-tag-2">Stages 1–2</span>
          <span class="syllabus-phase-title">Classical ML</span>
          <span class="syllabus-phase-dur">10–12 weeks</span>
          <a href="/dashboard" class="syllabus-phase-link">Open →</a>
        </div>
