  function renderResSidebar() {
    return RES_PHASES.map((p, i) => `
      <button class="res-side-btn${i === curResPhase ? ' active' : ''}" data-ridx="${i}">
        <span class="res-side-label">
          <span class="res-side-tag">${p.tag}</span>
          <span class="res-side-title">${p.title}</span>
          <span class="res-side-dur">${p.dur}</span>
        </span>
      </button>
    `).join('');
  }

  function renderResModuleTabs() {
    return RES_PHASES[curResPhase].topics.map((t, i) => `
      <button class="resc-mod-btn${i === curResModule ? ' active' : ''}" data-midx="${i}">${t.name}</button>
    `).join('');
  }

  function renderResFilterBar() {
    const filters = [
      { k:'all', l:'All' }, { k:'course', l:'Courses' }, { k:'yt', l:'YouTube' },
      { k:'book', l:'Books' }, { k:'paper', l:'Papers' }, { k:'repo', l:'Repos' }, { k:'web', l:'Websites' }
    ];
    return filters.map(f => `
      <button class="resc-f-btn${curResFilter === f.k ? ' active' : ''}" data-fk="${f.k}">${f.l}</button>
    `).join('');
  }

  function renderResItems() {
    const items = RES_PHASES[curResPhase].topics[curResModule].resources
      .filter(r => curResFilter === 'all' || r.t === curResFilter);
    if (!items.length) return '<div style="color:var(--text-muted);font-size:13px;padding:12px 0;">No resources match this filter.</div>';
    return items.map(r => `
      <a href="${r.u}" target="_blank" rel="noopener noreferrer" class="resc-card">
        <span class="resc-card-top">
          <span class="resc-badge resc-badge--${r.t}">${r.t}</span>
          <span class="resc-card-title">${r.l}</span>
        </span>
        <span class="resc-card-source">${r.s}</span>
      </a>
    `).join('');
  }

  function renderResContent() {
    const p = RES_PHASES[curResPhase];
    const rgb = rgbForPhase(curResPhase);
    return `
      <div class="resc-header">
        <span class="resc-tag" style="color:${DOT_COLORS[curResPhase]};background:rgba(${rgb},0.08);border:1px solid rgba(${rgb},0.15);">${p.tag}</span>
        <span class="resc-title">${p.title}</span>
        <span class="resc-dur">${p.dur}</span>
      </div>
      <div class="resc-mod-tabs">${renderResModuleTabs()}</div>
      <div class="resc-filter-bar">${renderResFilterBar()}</div>
      <div class="resc-items-grid">${renderResItems()}</div>
    `;
  }

  function attachResHandlers() {
    document.querySelectorAll('.res-side-btn').forEach(btn => {
      btn.addEventListener('click', () => { curResPhase = Number(btn.dataset.ridx); curResModule = 0; curResFilter = 'all'; refreshRes(); });
    });
    document.querySelectorAll('.resc-mod-btn').forEach(btn => {
      btn.addEventListener('click', () => { curResModule = Number(btn.dataset.midx); curResFilter = 'all'; refreshRes(); });
    });
    document.querySelectorAll('.resc-f-btn').forEach(btn => {
      btn.addEventListener('click', () => { curResFilter = btn.dataset.fk; refreshRes(); });
    });
  }

  function refreshRes() {
    document.getElementById('resSidebar').innerHTML = renderResSidebar();
    document.getElementById('resContent').innerHTML = renderResContent();
    attachResHandlers();
  }

  refreshRes();

  // ─── Smooth-scroll for anchor links ───
  document.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', e => {
      const id = link.getAttribute('href');
      const target = document.querySelector(id);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });

  // IntersectionObserver — reveal on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.08 });

  document.querySelectorAll(
    '.res-panel, .phase-row, .syllabus-phase-block, .guidance-card, .cta-banner, .section-header, .preview-panel'
  ).forEach(el => observer.observe(el));

  // Init lucide icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>

<Analytics />

</body>
</html>
